# Copy to .env at the repo root. Every var without a default is required —
# the app refuses to boot if one is missing (see apps/api/src/config).

NODE_ENV=development
PORT=5001

# Required. No fallback exists on purpose (see docs §9.1).
JWT_SECRET=test-secret-key

# Match these to whatever Postgres you are actually pointing at. If you are
# using a container someone else started, read the credentials off it rather
# than off a compose file — Postgres bakes the password into its data volume at
# first init, so a compose file can disagree with the running server:
#
#   docker inspect <container> --format '{{range .Config.Env}}{{println .}}{{end}}' | grep POSTGRES_
#
DB_HOST=localhost
DB_PORT=5432
DB_NAME=classyear_nest
DB_USER=postgres
DB_PASSWORD=password

FRONTEND_URL=http://localhost:5173
AWS_REGION=us-east-1

# Deployed only: when set, DB credentials come from Secrets Manager and
# DB_USER/DB_PASSWORD are ignored.
# DATABASE_SECRET_ARN=

# Unset locally so emailService logs to the console instead of sending.
# SES_FROM_EMAIL=

# --- S3 / MinIO ---------------------------------------------------------------
# S3_ENDPOINT is what makes the client talk to MinIO instead of AWS, and it also
# switches on path-style addressing. Leave it unset for real S3 — it has no
# default, deliberately: it used to default to a LocalStack URL, which meant
# every deployed environment would have addressed localhost (docs §15).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=classyear-dev
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password

# ADMIN_SEED_PASSWORD_PARAM=/classyear/dev/admin-seed-password

FEEDBACK_ENABLED=true
