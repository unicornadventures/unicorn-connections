{
  "name": "@classyear/web",
  "version": "1.0.0",
  "private": true,
  "description": "ClassYear web client — React 18 + Vite 5 + Tailwind 3",
  "type": "module",
  "_comment_test": "`vitest run`, not `vitest`: the source used watch mode, which hangs `npm test --workspaces` at the root forever.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@classyear/shared-types": "*",
    "axios": "^1.6.8",
    "jspdf": "^4.2.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.0.0",
    "vite": "^5.2.0",
    "vitest": "^1.1.0"
  }
}
