# Copy to apps/web/.env if you want the dev server to proxy the API.
#
# Relative: requests go to the Vite dev server, which proxies /api to the Nest
# server on port 5001 (see vite.config.ts). Same-origin, so no CORS.
VITE_API_BASE_URL=/api

# Absolute also works — src/api.ts falls back to this when the var is unset,
# and main.ts enables CORS for FRONTEND_URL:
# VITE_API_BASE_URL=http://localhost:5001/api

# Deployed, the SPA and the API share a domain behind CloudFront, so the
# relative form is what ships:
# VITE_API_BASE_URL=/api
