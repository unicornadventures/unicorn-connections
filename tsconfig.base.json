{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Compiler options shared by every TypeScript workspace. Individual packages extend this and add only what is genuinely theirs (outDir, decorators, DOM libs).",
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false
  }
}
